# Soulseek account used by the collector node.
# Register the nickname in any Soulseek client before the first run.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
SOULSEEK_SERVER_HOST=server.slsknet.org
SOULSEEK_SERVER_PORT=2416
SOULSEEK_LISTENING_PORT=2234

# The server only offers distributed parents to client versions it recognises.
# Left empty, the node connects and records NOTHING — that is intentional.
# Claiming another client's version number makes that project answerable for
# this node's behaviour, so it is never a default: setting these two is an
# explicit, informed decision by whoever runs the node.
SOULSEEK_CLIENT_VERSION_MAJOR=
SOULSEEK_CLIENT_VERSION_MINOR=

# ClickHouse connection. The host matches the service name in docker-compose.yml.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=soulseek_charts
CLICKHOUSE_USER=soulseek_charts
# Must not be empty: the ClickHouse entrypoint disables network access for a
# user without a password. Generate one with: openssl rand -hex 16
CLICKHOUSE_PASSWORD=

# Collector batching: events are flushed when either threshold is reached first.
COLLECTOR_BATCH_SIZE=1000
COLLECTOR_FLUSH_INTERVAL_SECONDS=5

# Key behind the stable pseudonym that replaces every username.
# 32 bytes, hex-encoded: openssl rand -hex 32
#
# This is a credential, not a setting: with it, stored pseudonyms can be
# reduced back to real nicknames. It must never travel with exported data.
# To keep pseudonyms comparable with the Go prototype's archive, use that
# node's own key: xxd -p -c 64 <prototype data dir>/pseudonym-secret
PRIVACY_HASH_SECRET=

# Logging level for every Python service: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
