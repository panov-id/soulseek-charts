<clickhouse>
    <!-- Kept below the container memory limit in docker-compose.yml (8G).
         Without this the server assumes the whole host RAM is available and
         gets OOM-killed instead of failing a single query. -->
    <max_server_memory_usage>6000000000</max_server_memory_usage>
    <max_concurrent_queries>50</max_concurrent_queries>

    <!-- Server logs are inside the container filesystem and need their own ceiling. -->
    <logger>
        <level>information</level>
        <size>100M</size>
        <count>5</count>
    </logger>
</clickhouse>
